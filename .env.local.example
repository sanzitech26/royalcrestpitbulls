NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Emails the admin when someone uses a contact form (server-only: never add NEXT_PUBLIC_ to these).
# Gmail: turn on 2-Step Verification, then Google Account > Security > App passwords, and paste the 16 characters
# (no spaces) as SMTP_PASS. SMTP_USER is the Gmail address that sends the mail.
SMTP_USER=
SMTP_PASS=
# Optional. Defaults: smtp.gmail.com, 465, and the inbox is SMTP_USER itself.
# SMTP_HOST=
# SMTP_PORT=
# INQUIRY_TO_EMAIL=
